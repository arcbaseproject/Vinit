# Maintainer: arcbaseproject <stormz5m@proton.me>
pkgname=vinit
pkgver=0.2.0
pkgrel=1
pkgdesc='Small init (PID 1) and service supervisor'
arch=('x86_64' 'aarch64')
url='https://github.com/arcbaseproject/Vinit'
license=('MIT')
depends=('glibc')
optdepends=('python: unit2vinit, to convert systemd units')
checkdepends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Fill in after the v0.2.0 tag exists: updpkgsums
sha256sums=('SKIP')

build() {
	cd "Vinit-$pkgver"
	# Dynamic link: Arch has /usr on the root filesystem. makepkg's
	# LDFLAGS from the environment override the Makefile's -static.
	make
}

check() {
	cd "Vinit-$pkgver"
	make test-unit test-contrib
}

package() {
	cd "Vinit-$pkgver"
	make DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm755 contrib/systemd/unit2vinit "$pkgdir/usr/bin/unit2vinit"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
